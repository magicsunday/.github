# Pinned Semgrep ENGINE version for the reusable code-scanning workflow — see
# AGENTS.md for why the pin lives here. The `p/*` rule packs that workflow scans
# with are fetched from the Semgrep registry at scan time and are NOT pinned by
# this file.
#
# semgrep.txt is the compiled, hash-locked closure — never hand-edit it.
# Regenerate after bumping the version below (see AGENTS.md for why the
# platform pin and pip-tools version below matter):
#   docker run --rm --platform linux/amd64 -v "$PWD:/work" -w /work python:3.12 bash -c "pip install pip-tools==7.6.1 && pip-compile --allow-unsafe --generate-hashes --output-file=semgrep.txt semgrep.in"
semgrep==1.173.0
