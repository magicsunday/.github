{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Shared Renovate preset of the repositories of this account, used as local>magicsunday/.github:renovate-config.",
    "extends": [
        "config:recommended",
        "docker:pinDigests",
        "helpers:pinGitHubActionDigests",
        ":disableDependencyDashboard"
    ],
    "timezone": "Europe/Berlin",
    "schedule": [
        "on monday"
    ],
    "minimumReleaseAge": "7 days",
    "prConcurrentLimit": 5,
    "labels": [
        "dependencies"
    ],
    "semanticCommits": "disabled",
    "commitMessagePrefix": "Update dependencies:",
    "commitMessageAction": "Bump",
    "customManagers": [
        {
            "description": "The tooling image that a workflow receives as its node-image input, so the digest pin reaches CI as well as the Compose file.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/[^/]+\\.ya?ml$/"
            ],
            "matchStrings": [
                "node-image: (?<depName>ghcr\\.io/magicsunday/webtrees-docker-module-base):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
            ],
            "datasourceTemplate": "docker",
            "autoReplaceStringTemplate": "node-image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
        },
        {
            "description": "The default of the node-image input in the shared workflows of this repository.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/[^/]+\\.ya?ml$/"
            ],
            "matchStrings": [
                "default: '(?<depName>ghcr\\.io/magicsunday/webtrees-docker-module-base):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?'"
            ],
            "datasourceTemplate": "docker",
            "autoReplaceStringTemplate": "default: '{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}'"
        }
    ],
    "packageRules": [
        {
            "description": "One grouped pull request per package manager.",
            "matchManagers": [
                "composer"
            ],
            "groupName": "composer"
        },
        {
            "matchManagers": [
                "npm"
            ],
            "groupName": "npm"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions"
        },
        {
            "description": "The Python version of the workflows is pinned on purpose, because the hash-locked pip closures are compiled for it, so a human moves it.",
            "matchManagers": [
                "github-actions"
            ],
            "matchDepNames": [
                "python"
            ],
            "enabled": false
        },
        {
            "description": "Patch, minor and digest updates of GitHub Actions merge by themselves once the required checks pass. Major updates stay with a human.",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor",
                "digest",
                "pin",
                "pinDigest"
            ],
            "automerge": true
        },
        {
            "description": "The chart library bundle is baked into the committed minified files at build time, so it arrives as its own pull request that a human reviews and rebuilds the bundle for.",
            "matchDepNames": [
                "@magicsunday/webtrees-chart-lib"
            ],
            "groupName": "webtrees-chart-lib"
        },
        {
            "description": "Every reference to the tooling image moves in one pull request, so the local build and CI keep using the same image.",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/magicsunday/webtrees-docker-module-base"
            ],
            "groupName": "tooling-image"
        },
        {
            "description": "Registries other than Docker Hub, ghcr.io among them, publish no release timestamp, so image updates would never count as old enough.",
            "matchDatasources": [
                "docker"
            ],
            "minimumReleaseAgeBehaviour": "timestamp-optional"
        },
        {
            "description": "Pins by git tag are taken without the age wait.",
            "matchDepNames": [
                "@magicsunday/coding-standard",
                "@magicsunday/webtrees-chart-lib"
            ],
            "minimumReleaseAge": null
        }
    ]
}
